# ─────────────────────────────────────────────────────────────────────────────
# LEXA configuration. Copy to .env and fill in. NEVER commit .env.
# infrastructure/scripts/install-vps.sh generates the random secrets for you.
# ─────────────────────────────────────────────────────────────────────────────

# Public domain (DNS A/AAAA record must point at the VPS)
LEXA_DOMAIN=lexa.example.com
PUBLIC_URL=https://lexa.example.com
API_URL=https://lexa.example.com
CORS_ORIGINS=https://lexa.example.com
LETSENCRYPT_EMAIL=admin@example.com

# Images (set by deploy.sh; the registry is your GHCR namespace, lower-case)
LEXA_REGISTRY=ghcr.io/your-github-user
LEXA_VERSION=latest

# ── Security (generate: openssl rand -hex 32 / python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
JWT_SECRET=
ENCRYPTION_KEY=
COOKIE_SECURE=true
ALLOW_REGISTRATION=true            # set false after creating your account

# ── Database / cache (internal only)
POSTGRES_USER=lexa
POSTGRES_PASSWORD=
POSTGRES_DB=lexa
REDIS_PASSWORD=
# DATABASE_URL / REDIS_URL are composed in docker-compose.yml; set them only for local development:
# DATABASE_URL=postgresql+asyncpg://lexa:lexa@localhost:5432/lexa
# REDIS_URL=redis://localhost:6379/0

# ── AI providers (server-side only; never exposed to the browser)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_MODEL=claude-opus-5-5
FAST_MODEL=claude-haiku-5-5
FALLBACK_MODEL=gpt-5.1
DEFAULT_EFFORT=high
ANTHROPIC_SERVER_FALLBACK=true
EMBEDDING_MODEL=text-embedding-3-small
# Override/extend model prices (USD per 1M tokens: [input, output, cache_read, cache_write])
# MODEL_PRICING_JSON={"gpt-5.1": [1.25, 10.0, 0.125, 0]}

# ── Limits
MONTHLY_BUDGET_USD=50
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT=20
TASK_TIMEOUT_SECONDS=900
WORKER_CONCURRENCY=4
MAX_UPLOAD_MB=20

# ── OAuth clients (redirect URIs: https://<domain>/api/integrations/<provider>/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Backups
BACKUP_RETENTION_DAYS=14
# Optional off-site copy with rclone (configure a remote first): BACKUP_RCLONE_REMOTE=b2:my-bucket/lexa
BACKUP_RCLONE_REMOTE=
